# backend/.env.migrate.example — Prisma CLI MIGRATION configuration (placeholders only).
#
# 1. Copy:   Copy-Item backend\.env.migrate.example backend\.env.migrate   (Git-ignored)
# 2. Replace BOTH <MIGRATOR_PASSWORD> placeholders with the restaurant_migrator password
#    (URL-encode special characters exactly as described in .env.example).
#
# Read ONLY by prisma.config.ts and the scripts in scripts/db/. The NestJS API never loads it.
# SHADOW_DATABASE_URL must point to the separate shadow database: Prisma wipes it.
# The hyphenated database name needs no encoding in the URL path.

MIGRATION_DATABASE_URL="postgresql://restaurant_migrator:<MIGRATOR_PASSWORD>@127.0.0.1:5432/restaurant_dev?schema=public"
SHADOW_DATABASE_URL="postgresql://restaurant_migrator:<MIGRATOR_PASSWORD>@127.0.0.1:5432/restaurant-dev-shadow?schema=public"
