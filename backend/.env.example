# backend/.env.example — RUNTIME configuration for the NestJS API (placeholders only).
#
# 1. Copy:   Copy-Item backend\.env.example backend\.env      (backend/.env is Git-ignored)
# 2. Replace <RUNTIME_PASSWORD> with the restaurant_app password (URL-encode special characters,
#    e.g. @ -> %40, : -> %3A, / -> %2F, # -> %23, ? -> %3F, & -> %26, % -> %25, + -> %2B, space -> %20).
#
# SECURITY: this file must contain ONLY the runtime role (restaurant_app).
# Never put MIGRATION_DATABASE_URL or SHADOW_DATABASE_URL here — the API refuses to start if it sees them.

DATABASE_URL="postgresql://restaurant_app:<RUNTIME_PASSWORD>@127.0.0.1:5432/restaurant_dev?schema=public"

NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Comma-separated list of explicit browser origins allowed by CORS ("*" is rejected).
CORS_ORIGIN=http://localhost:5173

# Global rate limit per client IP.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Staff login sessions (F03, decision D2). Absolute lifetime and idle timeout, in minutes.
SESSION_ABSOLUTE_TTL_MINUTES=720
SESSION_IDLE_TIMEOUT_MINUTES=120
