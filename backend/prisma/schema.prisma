// Prisma schema — Restaurant Management Portal
//
// Prisma 7: connection URLs are NOT declared here. They come from prisma.config.ts
// (migration/shadow, Prisma CLI only) and from the NestJS runtime (DATABASE_URL via @prisma/adapter-pg).
//
// Conventions (F02, human-approved 2026-11-16):
// - Database identifiers are snake_case (@map / @@map); Prisma identifiers are camelCase.
// - IDs are UUID v7 generated by Prisma Client (@default(uuid(7))). PostgreSQL 17 has no native uuidv7(),
//   so id columns have NO database default: inserts made outside Prisma Client must supply an id.
// - Money: Decimal(10,2). Stock quantities: Decimal(12,3). Never floating point.
// - Timestamps: timestamptz(6).
// - All foreign keys use ON DELETE RESTRICT / ON UPDATE RESTRICT: records are archived/deactivated, never hard-deleted.
// - CHECK constraints are NOT expressible in Prisma schema; they are added by hand in the migration SQL
//   (see prisma/migrations/*_init_schema/migration.sql). Prisma Migrate neither tracks nor drops them.
// - Name normalisation (menu categories, menu items, ingredients) — MANDATORY application rule (F07/F09):
//   display name = trim + collapse internal whitespace runs to one space + reject control characters
//   (tabs/newlines); nameKey = pgSimpleLower(name). DB CHECK: name_key = lower(btrim(name) COLLATE "pg_c_utf8"). Unicode
//   (including Urdu) is allowed. pgSimpleLower uses PostgreSQL 17's own case table (Q1b remediation).
// - Business policy that may change (e.g. "pay only after SERVED", cancellation rules, max quantity per line)
//   is enforced in services/DTOs, not in the database.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

/// Staff roles. Customers order as guests via table tokens (decision A2), so there is no CUSTOMER role.
enum StaffRole {
  OWNER
  KITCHEN_STAFF
  WAITER

  @@map("staff_role")
}

/// Base units; recipe quantities use the ingredient's unit.
enum IngredientUnit {
  G
  ML
  PCS

  @@map("ingredient_unit")
}

/// Order fulfilment status. Legal transitions are enforced in services (F11–F14).
enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED

  @@map("order_status")
}

/// Payment status is independent from fulfilment status (SERVED can remain UNPAID).
enum PaymentStatus {
  UNPAID
  PAID

  @@map("payment_status")
}

enum PaymentMethod {
  CASH

  @@map("payment_method")
}

enum InventoryMovementType {
  INITIAL_STOCK
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  WASTE

  @@map("inventory_movement_type")
}

// ─── Staff & identity ───────────────────────────────────────────────────────

/// Staff account (owner, kitchen staff, waiter).
model User {
  id            String    @id @default(uuid(7)) @db.Uuid
  fullName      String    @map("full_name") @db.VarChar(120)
  /// Stored lower-cased and trimmed (DB CHECK).
  email         String    @unique @db.VarChar(254)
  /// Argon2id hash. NULL until the staff member completes the one-time setup (requirements §9).
  passwordHash  String?   @map("password_hash") @db.VarChar(255)
  role          StaffRole
  isActive      Boolean   @default(false) @map("is_active")
  activatedAt   DateTime? @map("activated_at") @db.Timestamptz(6)
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  createdById   String?   @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy          User?               @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdUsers       User[]              @relation("UserCreatedBy")
  setupTokens        StaffSetupToken[]
  sessions           StaffSession[]
  acceptedOrders     Order[]             @relation("OrderAcceptedBy")
  readyOrders        Order[]             @relation("OrderReadyBy")
  servedOrders       Order[]             @relation("OrderServedBy")
  cancelledOrders    Order[]             @relation("OrderCancelledBy")
  inventoryMovements InventoryMovement[]
  recordedPayments   Payment[]

  @@index([role, isActive])
  @@index([createdById])
  @@map("users")
}

/// Single-use, expiring staff onboarding token (only the hash is stored).
model StaffSetupToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@map("staff_setup_tokens")
}

/// Server-side staff login session (F03, decision D1). The browser holds an opaque random token in an
/// HttpOnly cookie; only its SHA-256 hash is stored. Sessions are revoked (revoked_at), never deleted
/// by the runtime role (D5). Every request re-checks expiry, idle time, revocation and users.is_active.
model StaffSession {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// Hex SHA-256 of the session token. The plain token is never stored.
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Updated (throttled) on authenticated requests; drives the idle timeout.
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /// Absolute expiry, fixed at login.
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, revokedAt])
  @@map("staff_sessions")
}

// ─── Tables ─────────────────────────────────────────────────────────────────

model RestaurantTable {
  id                     String    @id @default(uuid(7)) @db.Uuid
  number                 Int       @unique
  label                  String?   @db.VarChar(60)
  isActive               Boolean   @default(true) @map("is_active")
  /// Hash of the opaque table ordering token (QR/table code). Plain token is never stored.
  orderingTokenHash      String?   @unique @map("ordering_token_hash") @db.VarChar(128)
  orderingTokenRotatedAt DateTime? @map("ordering_token_rotated_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders Order[]

  @@map("restaurant_tables")
}

// ─── Menu & recipes ─────────────────────────────────────────────────────────

model MenuCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Display name, normalised by the application (trim, collapse spaces, no control characters).
  name      String   @db.VarChar(80)
  /// Case-insensitive uniqueness key = lower(btrim(name) COLLATE "pg_c_utf8") (enforced by DB CHECK).
  nameKey   String   @unique @map("name_key") @db.VarChar(80)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  menuItems MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  /// Display name, normalised by the application (trim, collapse spaces, no control characters).
  name        String   @db.VarChar(120)
  /// Case-insensitive key = lower(btrim(name) COLLATE "pg_c_utf8") (DB CHECK); unique within a category.
  nameKey     String   @map("name_key") @db.VarChar(120)
  description String?  @db.VarChar(500)
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  /// Defaults to false: a dish without a recipe must not be published for ordering (requirements §7).
  isAvailable Boolean  @default(false) @map("is_available")
  isArchived  Boolean  @default(false) @map("is_archived")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category          MenuCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recipeIngredients RecipeIngredient[]
  orderItems        OrderItem[]

  @@unique([categoryId, nameKey])
  @@index([categoryId, isArchived, isAvailable])
  @@map("menu_items")
}

model Ingredient {
  id            String         @id @default(uuid(7)) @db.Uuid
  /// Display name, normalised by the application (trim, collapse spaces, no control characters).
  name          String         @db.VarChar(100)
  /// Normalised uniqueness key = lower(btrim(name) COLLATE "pg_c_utf8") (enforced by DB CHECK).
  nameKey       String         @unique @map("name_key") @db.VarChar(100)
  unit          IngredientUnit
  stockQuantity Decimal        @default(0) @map("stock_quantity") @db.Decimal(12, 3)
  minimumStock  Decimal        @default(0) @map("minimum_stock") @db.Decimal(12, 3)
  isArchived    Boolean        @default(false) @map("is_archived")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  recipeIngredients  RecipeIngredient[]
  orderRequirements  OrderIngredientRequirement[]
  inventoryMovements InventoryMovement[]

  @@map("ingredients")
}

/// Quantity of one ingredient required for ONE dish (in the ingredient's unit).
model RecipeIngredient {
  menuItemId      String   @map("menu_item_id") @db.Uuid
  ingredientId    String   @map("ingredient_id") @db.Uuid
  quantityPerDish Decimal  @map("quantity_per_dish") @db.Decimal(12, 3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([menuItemId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

// ─── Orders ─────────────────────────────────────────────────────────────────

model Order {
  id                  String        @id @default(uuid(7)) @db.Uuid
  /// Human-friendly display number (database sequence).
  orderNumber         Int           @unique @default(autoincrement()) @map("order_number")
  tableId             String        @map("table_id") @db.Uuid
  status              OrderStatus   @default(PENDING)
  paymentStatus       PaymentStatus @default(UNPAID) @map("payment_status")
  /// Hash of the unguessable guest tracking token. Plain token is never stored.
  trackingTokenHash   String        @unique @map("tracking_token_hash") @db.VarChar(128)
  /// Server-computed at creation from item price snapshots (items are immutable after creation).
  subtotal            Decimal       @db.Decimal(10, 2)
  acceptedById        String?       @map("accepted_by_id") @db.Uuid
  acceptedAt          DateTime?     @map("accepted_at") @db.Timestamptz(6)
  readyById           String?       @map("ready_by_id") @db.Uuid
  readyAt             DateTime?     @map("ready_at") @db.Timestamptz(6)
  servedById          String?       @map("served_by_id") @db.Uuid
  servedAt            DateTime?     @map("served_at") @db.Timestamptz(6)
  cancelledById       String?       @map("cancelled_by_id") @db.Uuid
  cancelledAt         DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  cancelReason        String?       @map("cancel_reason") @db.VarChar(300)
  /// Exactly-once stock consumption marker, set in the PENDING -> PREPARING transaction (requirements §8.3).
  inventoryDeductedAt DateTime?     @map("inventory_deducted_at") @db.Timestamptz(6)
  /// Optimistic concurrency version.
  version             Int           @default(0)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  table              RestaurantTable              @relation(fields: [tableId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  acceptedBy         User?                        @relation("OrderAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  readyBy            User?                        @relation("OrderReadyBy", fields: [readyById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  servedBy           User?                        @relation("OrderServedBy", fields: [servedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancelledBy        User?                        @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items              OrderItem[]
  requirements       OrderIngredientRequirement[]
  inventoryMovements InventoryMovement[]
  payment            Payment?

  @@index([status, createdAt])
  @@index([tableId, status])
  @@index([paymentStatus, status])
  @@index([acceptedById])
  @@index([readyById, readyAt])
  @@index([servedById, servedAt])
  @@index([cancelledById])
  @@map("orders")
}

/// Line item with frozen name and price snapshots (historic bills never change).
model OrderItem {
  id                String   @id @default(uuid(7)) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  menuItemId        String   @map("menu_item_id") @db.Uuid
  nameSnapshot      String   @map("name_snapshot") @db.VarChar(120)
  unitPriceSnapshot Decimal  @map("unit_price_snapshot") @db.Decimal(10, 2)
  quantity          Int
  instructions      String?  @db.VarChar(300)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

/// Aggregated recipe consumption frozen at order creation (requirements §7).
model OrderIngredientRequirement {
  orderId          String   @map("order_id") @db.Uuid
  ingredientId     String   @map("ingredient_id") @db.Uuid
  requiredQuantity Decimal  @map("required_quantity") @db.Decimal(12, 3)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([orderId, ingredientId])
  @@index([ingredientId])
  @@map("order_ingredient_requirements")
}

// ─── Inventory audit ────────────────────────────────────────────────────────

/// Append-only stock ledger. Corrections are new ADJUSTMENT/WASTE rows, never edits (requirements §8).
model InventoryMovement {
  id            String                @id @default(uuid(7)) @db.Uuid
  ingredientId  String                @map("ingredient_id") @db.Uuid
  /// Required for STOCK_OUT and only allowed for STOCK_OUT (DB CHECK).
  orderId       String?               @map("order_id") @db.Uuid
  type          InventoryMovementType
  quantityDelta Decimal               @map("quantity_delta") @db.Decimal(12, 3)
  balanceAfter  Decimal               @map("balance_after") @db.Decimal(12, 3)
  reason        String?               @db.VarChar(300)
  unitCost      Decimal?              @map("unit_cost") @db.Decimal(10, 2)
  actorId       String                @map("actor_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor      User       @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Prevents deducting the same ingredient twice for one order.
  @@unique([orderId, ingredientId, type])
  @@index([ingredientId, createdAt])
  @@index([actorId])
  @@map("inventory_movements")
}

// ─── Billing ────────────────────────────────────────────────────────────────

/// One cash payment per order in the MVP (requirements §11/§12).
model Payment {
  id             String        @id @default(uuid(7)) @db.Uuid
  orderId        String        @unique @map("order_id") @db.Uuid
  method         PaymentMethod @default(CASH)
  subtotal       Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(10, 2)
  recordedById   String        @map("recorded_by_id") @db.Uuid
  paidAt         DateTime      @default(now()) @map("paid_at") @db.Timestamptz(6)
  note           String?       @db.VarChar(300)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  order      Order @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recordedBy User  @relation(fields: [recordedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([recordedById])
  @@index([paidAt])
  @@map("payments")
}
