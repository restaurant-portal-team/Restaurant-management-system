{
  "name": "restaurant-portal-backend",
  "version": "0.1.0",
  "description": "Restaurant Management Portal API (NestJS + Prisma + PostgreSQL)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" prisma.config.ts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:db": "vitest run --config ./vitest.config.db.ts",
    "unicode:generate": "node scripts/unicode/generate-pg-simple-lower.ts",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:verify-roles": "node scripts/db/verify-roles.ts",
    "db:assert-isolation": "node scripts/db/assert-isolation.ts",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:check-shadow": "npm run db:assert-isolation && prisma migrate diff --config prisma.shadow-check.config.ts --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "db:migrate:deploy": "npm run db:assert-isolation && prisma migrate deploy",
    "auth:bootstrap-owner": "node scripts/auth/bootstrap-owner.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/throttler": "^6.8.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "1.4.7",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.4.2",
    "prisma": "7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
